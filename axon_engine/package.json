{
  "name": "headless-engine-express",
  "version": "1.0.0",
  "description": "Headless CMS Engine - Express + pg + PostgreSQL",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js latest",
    "migrate:rollback": "node src/db/migrate.js rollback",
    "seed": "node src/db/seed.js",
    "seed:fetch-fixtures": "node scripts/fetch-organization-fixtures.js",
    "setup": "node src/db/migrate.js latest && node src/db/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.0",
    "uuid": "^10.0.0"
  }
}
